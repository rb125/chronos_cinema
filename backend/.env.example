# Auth mode: project (ADC) or api_key
VERTEX_AUTH_MODE=project

# GCP project (required for project mode)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Model overrides (optional — defaults shown)
# GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
# GEMINI_SCRIPT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TEXT_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_MUSIC_MODEL=lyria-002

GENERATE_VIDEO=false
